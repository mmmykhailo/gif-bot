{
  "name": "telegram-gif-bot",
  "version": "1.0.0",
  "description": "High-performance Telegram GIF search and indexing bot",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "scrape": "bun run src/scraper.ts",
    "scrape:debug": "bun run src/scraper-debug.ts"
  },
  "dependencies": {
    "grammy": "^1.21.1",
    "linkedom": "^0.16.10"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
